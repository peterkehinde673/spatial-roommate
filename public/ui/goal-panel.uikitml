<style>
  .root {
    width: 420px;
    padding: 24px;
    flex-direction: column;
    gap: 14px;
    background-color: #111827;
  }

  .title {
    font-size: 30px;
    color: white;
  }

  .subtitle {
    font-size: 18px;
    color: #cbd5e1;
  }

  .choice {
    width: 360px;
    height: 64px;
    padding: 14px;
    background-color: #1e293b;
    color: white;
    font-size: 20px;
  }

  .choice:hover {
    background-color: #334155;
  }
</style>

<Panel class="root">
  <h1 class="title">What are we working on?</h1>
  <div class="subtitle">Choose a direction, then Roommate will shape the workspace around it.</div>
  <button class="choice" id="build-goal">Build something</button>
  <button class="choice" id="learn-goal">Learn a skill</button>
  <button class="choice" id="plan-goal">Plan something</button>
</Panel>
